{
    "name": "nano-code-devcontainer",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "workspaceFolder": "/nano-code",
    "remoteUser": "vscode",
    "mounts": [
        "source=${localWorkspaceFolder},target=/nano-code,type=bind",
        "source=nano-code-bun-cache,target=/home/vscode/.bun-cache,type=volume"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh"
            },
            "extensions": [
                "GitHub.copilot",
                "GitHub.copilot-chat"
            ]
        }
    },
    "postCreateCommand": "zsh .devcontainer/setup-dotfiles.sh && if [ ! -f package.json ]; then bun init -y; fi && (bun install || true)"
}
